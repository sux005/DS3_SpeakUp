# Copy the environment-specific example instead of editing this file.
# These are resource identifiers, not credentials. Never add AWS access keys,
# Cognito tokens, or other secrets to a committed env file.
SPEAKUP_ENV=
AWS_REGION=us-east-2
AWS_STACK_NAME=

# Values consumed by the browser/client application.
SPEAKUP_API_URL=
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
COGNITO_ISSUER=

# Server and operational identifiers. CloudFormation injects the corresponding
# values into Lambda; do not expose these variables through a public env prefix.
DATA_BUCKET=
PROJECTS_TABLE=
RECORDINGS_TABLE=
PROCESSING_STATE_MACHINE_ARN=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
