# Production schema. Populate values from the speakup-prod CloudFormation
# outputs after that stack is deployed in the project's selected Region.
# Never copy development resource IDs into production.
SPEAKUP_ENV=prod
AWS_REGION=us-east-2
AWS_STACK_NAME=speakup-prod

# Browser/client configuration (required after production deployment).
SPEAKUP_API_URL=
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
COGNITO_ISSUER=

# Server and operational identifiers (required after production deployment).
DATA_BUCKET=
PROJECTS_TABLE=
RECORDINGS_TABLE=
PROCESSING_STATE_MACHINE_ARN=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
